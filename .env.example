# Copy this file to .env and replace both blank secrets before starting Docker.
POSTGRES_DB=criminal_network
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
API_KEY=

# Vercel server-side proxy only; never use a VITE_ prefix for this value.
BACKEND_URL=http://localhost:8000
